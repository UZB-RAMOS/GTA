; Toshkentdan ilhomlangan original ochiq-dunyo prototipi
; Godot 4.7.2

config_version=5

[application]

config/name="Toshkent Sarguzashti"
config/version="0.4.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.42, 0.72, 0.9, 1)

[physics]

common/physics_ticks_per_second=60

[layer_names]

3d_physics/layer_1="Dunyo"
3d_physics/layer_2="Oyinchi"
3d_physics/layer_3="Transport"
3d_physics/layer_4="NPC"

